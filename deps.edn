{:paths ["src"]
 ;; The ONE runtime dependency, and it is a protocol + combinators with
 ;; `:deps {}` of its own -- so this library's whole transitive runtime
 ;; closure is `datom.source`. Deliberately absent: io-ipld, io-multiformats,
 ;; prolly-tree, block-cache. Nothing here stores, hashes, or addresses
 ;; anything. Pinned to the same SHA `kotoba-lang/arrangement`'s main uses.
 :deps {io.github.kotoba-lang/datom-source
        {:git/sha "19dc98ad5272da6648c27eada8e1ed76cac85d8d"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cardinality-bench {:extra-paths ["bench"]
                      :main-opts ["-m" "datalog.cardinality-bench"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
